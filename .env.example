# Skopiuj ten plik jako .env i uzupełnij klucze. NIE wrzucaj .env na GitHuba.

# Google Places API (New) – wyszukiwanie firm w Google Maps (zalecane)
GOOGLE_PLACES_API_KEY=

# Google PageSpeed Insights – szybkość i SEO na telefonie (może być ten sam klucz co wyżej)
PAGESPEED_API_KEY=

# Anthropic (Claude) – ocena wyglądu strony ze zrzutu ekranu
ANTHROPIC_API_KEY=

# Opcjonalnie: Brave Search API do szukania e-maili/Facebooka firm bez strony (tylko poza trybem darmowym).
# Bez klucza agent używa darmowego DuckDuckGo.
BRAVE_API_KEY=

# 1 = szukaj innych kontaktów (e-mail, Facebook, Instagram, portale) dla firm bez strony z telefonem
SCOUT_KONTAKTY=1

# 1 = tylko darmowe limity (OpenStreetMap + PageSpeed, bez Google Places i bez AI)
# 0 = włącz płatne usługi (Google Places, ocena wyglądu przez Claude)
SCOUT_TYLKO_DARMOWE=1

# real = prawdziwe dane, mock = test bez internetu
SCOUT_MODE=real
# Limit wydatków na Claude w USD na jedno uruchomienie
SCOUT_BUDGET_USD=2.00
# Model Claude i poziom wysiłku (low/medium/high)
SCOUT_CLAUDE_MODEL=claude-opus-5-5
SCOUT_CLAUDE_EFFORT=medium
# Ile wyników z Google na jedno zapytanie (max 60)
SCOUT_MAX_PER_QUERY=40
# Minimalny wynik leada (0-100)
SCOUT_MIN_SCORE=35

# Automatyczne aktualizacje programu: adres zipa z najnowszą wersją (np. repozytorium GitHub).
# Zostaw puste, jeśli nie chcesz aktualizacji. Przykład:
# SCOUT_UPDATE_URL=https://github.com/twoje-konto/scout-agent/archive/refs/heads/main.zip
SCOUT_UPDATE_URL=

# --- Maile do firm (scout/outreach.py). Bez SMTP_HOST agent tylko przygotowuje szkice. ---
# Dane skrzynki, z której mają iść maile (hasło do poczty zwykle trzeba wygenerować jako „hasło aplikacji”).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=starttls
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_COMPANY=
MAIL_SIGNATURE=
# 1 = agent sam wysyła szkice po wyszukiwaniu (w dni robocze, w godzinach, w dziennym limicie)
SCOUT_AUTOWYSYLKA=0
SCOUT_MAILE_DZIENNIE=20
SCOUT_MAILE_PRZERWA_S=60
SCOUT_MAILE_GODZINY=9-17
SCOUT_MAILE_MIN_PRIORYTET=B
